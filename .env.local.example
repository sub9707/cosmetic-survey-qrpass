# 실행 환경 (draft-modular-coral.md 참고: 홈랩=mysql, 이후=postgres)
DB_PROVIDER=mysql

# MySQL (홈랩)
# 로컬 개발은 `docker compose -f docker-compose.dev.yml up -d`로 아래 값 그대로 사용 가능
# (로컬에 이미 3306 포트를 쓰는 MySQL이 있을 수 있어 dev 컨테이너는 33306으로 노출)
MYSQL_HOST=localhost
MYSQL_PORT=33306
MYSQL_USER=qrpass
MYSQL_PASSWORD=qrpasspw
MYSQL_DATABASE=qr_pass

# Postgres/Supabase (이후 오브젝트 스토리지+DB 전환 단계)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# 인증
JWT_SECRET=

# HTTPS로 서빙할 때만 true (server/session.ts). HTTP로만 서빙하면 반드시 false 유지 —
# true인데 HTTPS가 아니면 브라우저가 세션 쿠키를 저장 안 해서 스태프/관리자 로그인이 계속 풀린다.
COOKIE_SECURE=false

# 참가자 이름/전화번호 DB 암호화 키 (openssl rand -hex 32 로 생성, 32바이트 hex).
# 분실하거나 교체하면 그 전에 저장된 이름/전화번호는 복호화 불가 + 중복등록 확인도 깨짐.
PII_ENCRYPTION_KEY=

# 카카오 알림톡 (mock 단계에서는 미사용)
KAKAO_MODE=mock
KAKAO_API_KEY=
KAKAO_SENDER_KEY=
KAKAO_TEMPLATE_CODE=

# QR 이미지 임시 저장소 (라즈베리파이 미디어 서버). 나중에 오브젝트 스토리지로 교체 예정
# (src/lib/storage/provider.ts). 실제 값은 팀 내부 공유 채널 참고.
MEDIA_SERVER_URL=http://localhost:3000

APP_URL=http://localhost:3000
