# 실행 환경 (draft-modular-coral.md 참고: 홈랩=mysql, 이후=postgres)
DB_PROVIDER=mysql

# MySQL (홈랩)
# 로컬 개발은 `docker compose -f docker-compose.dev.yml up -d`로 아래 값 그대로 사용 가능
# (로컬에 이미 3306 포트를 쓰는 MySQL이 있을 수 있어 dev 컨테이너는 33306으로 노출)
MYSQL_HOST=localhost
MYSQL_PORT=33306
MYSQL_USER=qrpass
MYSQL_PASSWORD=qrpasspw
MYSQL_DATABASE=qr_pass

# Postgres/Supabase (이후 Workers 단계)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# 인증
JWT_SECRET=

# 카카오 알림톡 (mock 단계에서는 미사용)
KAKAO_MODE=mock
KAKAO_API_KEY=
KAKAO_SENDER_KEY=
KAKAO_TEMPLATE_CODE=

APP_URL=http://localhost:3000
